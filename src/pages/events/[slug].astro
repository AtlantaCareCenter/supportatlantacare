---
// One event's own page. Drafts get a page too (so staff can preview them on the
// real site) but are not listed anywhere.
// Archived events get no page.
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Buttons from '../../components/Buttons.astro';
import Wave from '../../components/Wave.astro';
import { loadSite, md } from '../../lib/md';
import { occurrences, formatDate, timeFor, repeatSummary, isRepeating, isLive, today, mapsUrl } from '../../lib/events';

export async function getStaticPaths() {
  const events = await getCollection('events', (e) => (e.data.status ?? 'published') !== 'archived');
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}
await loadSite();
const { event } = Astro.props;
const ev = event.data;
const now = today();
const draft = (ev.status ?? 'published') === 'draft';
const notYet = !draft && !isLive(ev, now);
const dates = isRepeating(ev) ? occurrences(ev, now).filter((d) => d >= now).slice(0, 6) : occurrences(ev, now);
const repeatText = repeatSummary(ev);
---
<Base title={ev.title} description={ev.summary}>
  <div class="page-title">
    <p class="h1">Events</p>
    <Wave />
  </div>
  {draft && <p class="preview-note">Draft preview. This event is not shown on the site yet; set its status to Published in the editor when it's ready.</p>}
  {notYet && <p class="preview-note">Preview. This event is published but outside its go-live window, so it isn't listed yet.</p>}
  <section class="section event-page">
    <div class="container">
      <article class="event-detail">
        <h1 class="h2">{ev.title}</h1>
        {repeatText && <p class="repeat">{repeatText}</p>}
        <ul class="dates">
          {dates.map((d) => <li><span class="date">{formatDate(d)}</span>{timeFor(ev, d) && <span class="time">{timeFor(ev, d)}</span>}</li>)}
        </ul>
        {ev.location && <p class="location"><a href={mapsUrl(ev.location)} target="_blank" rel="noopener">{ev.location}</a></p>}
        {ev.image && <img class="photo" src={ev.image} alt={ev.image_alt ?? ''} />}
        <div class="prose" set:html={md(event.body)} />
        <Buttons label={ev.link_label} url={ev.link_url} more={ev.buttons} requireUrl />
        <p class="back"><a href="/events/">← All events</a></p>
      </article>
    </div>
  </section>
</Base>
