---
import Button from './Button.astro';
import { md, mdInline } from '../lib/md';
const { heading, text, button_label, button_url } = Astro.props;
---
<section class="section callout">
  <div class="container inner">
    <h2 set:html={mdInline(heading)} />
    {text && <div class="prose" set:html={md(text)} />}
    <Button href={button_url} label={button_label} />
  </div>
</section>
